{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Full Stack (API + SolidJS)",
            "configurations": [
                "API",
                "Frontend (SolidJS)"
            ],
            "stopAll": true
        }
    ],
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/hardware-tycoon-api/bin/Debug/net10.0/hardware-tycoon-api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/hardware-tycoon-api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "type": "chrome",
            "runtimeExecutable": "/usr/bin/chromium",
            "name": "Frontend (SolidJS)",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend-solid",
            "preLaunchTask": "npm: dev (frontend-solid)",
            "serverReadyAction": {
                "pattern": "Local:.*http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "debugWithChrome"
            }
        }
    ]
}