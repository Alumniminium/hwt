{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/hardware-tycoon-api/hardware-tycoon-api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "npm: dev (frontend-solid)",
            "type": "npm",
            "script": "dev",
            "path": "frontend-solid/",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^([^\\s].*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE.*preparing",
                    "endsPattern": "(Local:|ready in|VITE.*ready)"
                }
            }
        }
    ]
}